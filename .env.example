# =============================================================================
# AppGate Dev-Portal — Environment Configuration Example
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# --- BFF Server ---
DP_BIND=:8080
DP_LOG_LEVEL=info
DP_LOG_FORMAT=json

# --- Control Plane Connection ---
# Point to the AppGate Control Plane (Go or Rust)
DP_CP_BASE_URL=http://localhost:8081
DP_CP_AUTH_TOKEN=
# Or use client credentials:
# DP_CP_CLIENT_ID=
# DP_CP_CLIENT_SECRET=
DP_CP_TIMEOUT=15s
DP_CP_MAX_RETRIES=2
DP_CP_TLS_INSECURE=true

# --- Session (optional — stateless bearer tokens also supported) ---
DP_SESSION_SECRET=CHANGE-ME-TO-A-32-BYTES-LONG-SECRET
DP_SESSION_MAX_AGE=15m

# --- Rate Limiting ---
DP_API_RATE_LIMIT=100
DP_API_RATE_BURST=200
DP_API_RATE_WINDOW=1m

# --- CORS ---
DP_ALLOWED_ORIGINS=http://localhost:3000

# --- TLS (optional, production only) ---
DP_TLS_ENABLED=false
DP_TLS_CERT_PATH=
DP_TLS_KEY_PATH=

# --- Control Plane Configuration (for control-plane-ext) ---
# CP_BIND=0.0.0.0:8081
# CP_LOG_LEVEL=info
# CP_LOG_FORMAT=json
# CP_JWT_SIGNING_METHOD=RS256
# CP_JWT_ISSUER=appgate
# CP_JWT_AUDIENCE=appgate-api
# CP_JWT_TOKEN_EXPIRY=24h
# CP_STORE_PATH=/data/store.json
# CP_JWT_PRIVATE_KEY_PATH=/path/to/private.pem