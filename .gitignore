# =============================================================================
# AppGate Dev-Portal — .gitignore
# =============================================================================

# --- Environment files (NEVER commit secrets) ---
.env
.env.*
!.env.example

# --- Go ---
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
vendor/
*.test
*.out
*.prof

# --- Node / Web ---
apps/web/node_modules/
apps/web/dist/
apps/web/.vite/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml
deploy/docker/.env

# --- Terraform ---
deploy/terraform/.terraform/
deploy/terraform/terraform.tfstate*
deploy/terraform/*.tfvars

# --- Build artifacts ---
*.log
tmp/
.reference/

# --- Control plane runtime data ---
control-plane-ext/data/
*store.json